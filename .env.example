# Project Kinly — environment (copy to .env; never commit .env)
PORT=8787
KINLY_DB=./data/kinly.db                # on Railway: /data/kinly.db (volume)
KINLY_DATA_REPO=angellog/kinly          # public repo that archives data/ and reports/
KINLY_DATA_BRANCH=main
KINLY_API_TOKEN=                        # bearer token required on POST routes
GITHUB_TOKEN=                           # optional: fine-grained PAT (public read + contents:write on KINLY_DATA_REPO). Keyless mode works without it.
ANTHROPIC_API_KEY=                      # optional: enables LLM summaries and /api/ask
KINLY_LLM_MODEL=claude-sonnet-5-5
KINLY_LLM_DAILY_CAP=400000              # max LLM tokens per UTC day
KINLY_TIMEZONE=UTC
