# Project Kinly — environment (copy to .env; never commit .env)
PORT=8787
KINLY_DB=                               # default ./.kinly/kinly.db; on Railway: /data/kinly.db (volume)
KINLY_DATA_ROOT=../kinly-data           # checkout of the data repo (data/, reports/, resources/); on Railway: /data/repo
KINLY_DATA_REPO=angellog/kinly-data     # public repo that archives data/, reports/ and resources/
KINLY_DATA_BRANCH=main
KINLY_API_TOKEN=                        # bearer token required on POST routes and /api/export
GITHUB_TOKEN=                           # fine-grained PAT: public read + contents:write on KINLY_DATA_REPO only. Keyless mode runs without it, degraded.
ANTHROPIC_API_KEY=                      # optional: LLM summaries, /api/ask, /api/research
KINLY_LLM_MODEL=claude-opus-5-5
KINLY_LLM_DAILY_CAP=400000              # max LLM tokens per UTC day, across every LLM path
KINLY_DAILY_CRON=40 5 * * *             # daily pipeline (UTC)
KINLY_WEEKLY_CRON=40 6 * * 1            # weekly report (UTC, Monday)
